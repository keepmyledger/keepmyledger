{
  "name": "@keepmyledger/server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations dist/db/migrations-pg && cp src/db/migrations/*.sql dist/db/migrations/ && cp src/db/migrations-pg/*.sql dist/db/migrations-pg/",
    "dev": "NODE_OPTIONS=--experimental-sqlite ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "npm run build --prefix ../shared && tsc --noEmit",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "NODE_ENV=test NODE_OPTIONS='--max-old-space-size=4096 --experimental-sqlite --no-warnings' jest",
    "test:pg": "NODE_ENV=test TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://kml:kml@127.0.0.1:5433/kml} NODE_OPTIONS='--max-old-space-size=4096 --experimental-sqlite --no-warnings' jest --runInBand",
    "test:both": "npm test && npm run test:pg"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-sesv2": "^3.1052.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@keepmyledger/shared": "*",
    "@sentry/node": "^10.53.1",
    "argon2": "^0.44.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "openai": "^4.52.1",
    "otpauth": "^9.5.1",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "passport-google-oauth20": "^2.0.0",
    "passport-microsoft": "^2.1.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-apple": "^2.0.3",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-microsoft": "^2.1.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
